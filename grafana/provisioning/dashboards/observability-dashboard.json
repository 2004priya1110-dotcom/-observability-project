{
  "title": "Flask Application Observability",
  "uid": "flask-observability",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "title": "Request Rate",
      "type": "timeseries",
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "sum(rate(flask_http_request_total[1m]))",
          "legendFormat": "Requests per second",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Total HTTP Requests",
      "type": "timeseries",
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 0},
      "targets": [
        {
          "expr": "sum(flask_http_request_total)",
          "legendFormat": "Total requests",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "HTTP Request Duration",
      "type": "timeseries",
      "gridPos": {"h": 9, "w": 24, "x": 0, "y": 9},
      "targets": [
        {
          "expr": "rate(flask_http_request_duration_seconds_sum[1m]) / rate(flask_http_request_duration_seconds_count[1m])",
          "legendFormat": "Average duration",
          "refId": "A"
        }
      ]
    }
  ]
}
